<?xml version="1.0" encoding="UTF-8"?>
<!--
  reservas-infrastructure · adaptadores. Primer módulo con tecnología:
    · spring-boot-starter-data-jpa   JPA + Hibernate + Spring Data + JDBC
    · sqlite-jdbc                    driver de SQLite
    · hibernate-community-dialects   dialecto de SQLite para Hibernate
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cl.dasacademy.reservas</groupId>
        <artifactId>reservas</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>reservas-infrastructure</artifactId>
    <name>reservas-infrastructure</name>

    <dependencies>
        <dependency>
            <groupId>cl.dasacademy.reservas</groupId>
            <artifactId>reservas-application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
