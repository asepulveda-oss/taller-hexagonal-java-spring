<?xml version="1.0" encoding="UTF-8"?>
<!--
  reservas · POM PADRE (esqueleto vacío)

  Solo declara los módulos y fija versiones. Las dependencias apuntan hacia adentro
  y las verifica el build:

      reservas-api ──► reservas-infrastructure ──► reservas-application ──► reservas-domain ──► (nadie)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>cl.dasacademy.reservas</groupId>
    <artifactId>reservas</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>reservas</name>
    <description>Taller Introducción a la Arquitectura Hexagonal con Spring Boot · DAS Academy</description>

    <modules>
        <module>reservas-domain</module>
        <module>reservas-application</module>
        <module>reservas-infrastructure</module>
        <module>reservas-api</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.8.17</springdoc.version>
        <!-- Solo reservas-api tiene clase main: se apaga acá y se prende en su pom. -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cl.dasacademy.reservas</groupId>
                <artifactId>reservas-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cl.dasacademy.reservas</groupId>
                <artifactId>reservas-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cl.dasacademy.reservas</groupId>
                <artifactId>reservas-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
