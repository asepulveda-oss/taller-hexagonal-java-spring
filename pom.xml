<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cl.dasacademy.reservas</groupId>
        <artifactId>reservas</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>reservas-infrastructure</artifactId>
    <name>reservas-infrastructure</name>

    <dependencies>
        <dependency>
            <groupId>cl.dasacademy.reservas</groupId>
            <artifactId>reservas-application</artifactId>
        </dependency>

        <!-- ── Clase 3: la base de datos ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <!-- spring-boot-starter-test trae JUnit 5 y además @DataJpaTest, que solo
             usan los dos tests de los adaptadores de base de datos. Todos los demás
             tests de este módulo son JUnit puro. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
